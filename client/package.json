{
  "name": "portfolio-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "lex:build": "lex build --lexicons ./lexicons --out ./src/lexicons --index-file --override",
    "dev": "npm run lex:build && vite",
    "dev:docker": "npm run lex:build && vite --mode docker",
    "build": "npm run lex:build && tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run lex:build && vitest run",
    "coverage": "npm run lex:build && vitest run --coverage",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@atproto/lex": "^0.5.0",
    "@atproto/oauth-client-browser": "^0.5.14",
    "@google/model-viewer": "^4.4.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-youtube": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
