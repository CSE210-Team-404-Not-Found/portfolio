# Where the client is deployed (Cloudflare Workers). Production
# builds publish the OAuth client metadata at <VITE_APP_URL>client-metadata.json,
# which is the app's OAuth client_id, and sign-in redirects back to this URL.
# Development (`npm run dev`) doesn't read this file and uses a loopback client.
VITE_APP_URL=https://portfolio.atfolio.workers.dev/
